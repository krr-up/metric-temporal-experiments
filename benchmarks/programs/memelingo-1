#!/usr/bin/env bash

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check if at least one argument is provided
if [ $# -eq 0 ]; then
    exit 1
fi

# Find and extract the --approach argument
SOLVER=""
ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --approach)
            if [ -n "$2" ]; then
                SOLVER="$2"
                shift 2
            else
                echo "Error: --approach requires an argument"
                exit 1
            fi
            ;;
        --approach=*)
            SOLVER="${1#*=}"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Check if solver was specified
if [ -z "$SOLVER" ]; then
    echo "Error: --approach not specified"
    echo "Usage: memelingo --approach <solver> [files...] [options...]"
    echo "Available solvers: mlp-tplp-ht, mlp-tplp-htc, mlp-tplp-htcdl, mlp-lpnmr-ht, mlp-lpnmr-htc, mlp-lpnmr-htcdl"
    exit 1
fi

# Dispatch to the appropriate meta script
case "$SOLVER" in
    mlp-tplp-htcdl)
        exec "$SCRIPT_DIR/meta-tplp-clingo.sh" "${ARGS[@]}"
        ;;
    mlp-tplp-htc)
        exec "$SCRIPT_DIR/meta-tplp-clingcon.sh" "${ARGS[@]}"
        ;;
    mlp-tplp-ht)
        exec "$SCRIPT_DIR/meta-tplp-clingodl.sh" "${ARGS[@]}"
        ;;
    mlp-lpnmr-ht)
        exec "$SCRIPT_DIR/meta-lpnmr-clingo.sh" "${ARGS[@]}"
        ;;
    mlp-lpnmr-htc)
        exec "$SCRIPT_DIR/meta-lpnmr-clingcon.sh" "${ARGS[@]}"
        ;;
    mlp-lpnmr-htcdl)
        exec "$SCRIPT_DIR/meta-lpnmr-clingodl.sh" "${ARGS[@]}"
        ;;
    *)
        echo "Error: Unknown solver '$SOLVER'"
        echo "Available solvers: mlp-tplp-ht, mlp-tplp-htc, mlp-tplp-htcdl, mlp-lpnmr-ht, mlp-lpnmr-htc, mlp-lpnmr-htcdl"
        exit 1
        ;;
esac
