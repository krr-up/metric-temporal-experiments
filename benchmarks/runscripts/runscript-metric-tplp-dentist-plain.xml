<runscript output="output/dentistplain">

	<machine name="houat" cpu="8xE5520@2.27GHz" memory="24GB" />

	<config name="seq-generic" template="templates/seq-generic.sh" />


	<system name="memelingo" version="1" measures="rp_tmp"
		config="seq-generic"
		cmdline="">
		<setting name="simple" tag="simple">
			<variable cmd="{} --models=0 --project=show --stats -c lambda=4"
				value="mlp-tplp-ht;mlp-tplp-htc;mlp-tplp-htcdl;mlp-lpnmr-ht;mlp-lpnmr-htc;mlp-lpnmr-htcdl" />
		</setting>
		<setting name="goal" tag="goal">
			<variable cmd="{} --models=0 --project=show --stats -c lambda=4"
				value="mlp-tplp-ht;mlp-tplp-htc;mlp-tplp-htcdl" />
		</setting>
	</system>


	<distjob name="dist-generic" timeout="1200s" runs="1" template_options="--single"
		script_mode="timeout" walltime="23h 59m 59s" cpt="4" />

	<benchmark name="dentist-simple">
		<files path="../examples/dentist">
			<encoding file="../examples/dentist/dentist.lp" />
			<add file="instances/size-1.lp" cmdline="-c v=110" />
			<add file="instances/size-2.lp" cmdline="-c v=220" />
			<add file="instances/size-3.lp" cmdline="-c v=330" />
			<add file="instances/size-4.lp" cmdline="-c v=440" />
			<add file="instances/size-5.lp" cmdline="-c v=550" />
			<add file="instances/size-6.lp" cmdline="-c v=660" />
			<add file="instances/size-7.lp" cmdline="-c v=770" />
			<add file="instances/size-8.lp" cmdline="-c v=880" />
			<add file="instances/size-9.lp" cmdline="-c v=990" />
			<add file="instances/size-10.lp" cmdline="-c v=1100" />
		</files>
	</benchmark>


	<project
		name="clasp-seq" job="dist-generic">
		<runtag machine="houat" benchmark="dentist-simple" tag="simple" />
	</project>


</runscript>
