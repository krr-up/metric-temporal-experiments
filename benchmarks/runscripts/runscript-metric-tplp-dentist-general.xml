<runscript output="output/dentistgeneral">

	<machine name="houat" cpu="8xE5520@2.27GHz" memory="24GB" />

	<config name="seq-generic" template="templates/seq-generic.sh" />


	<system name="memelingo" version="1" measures="rp_tmp"
		config="seq-generic"
		cmdline="--project=show --stats -c lambda=4">
		<setting name="simple" tag="simple">
			<variable cmd="--approach={}"
				value="mlp-tplp-ht;mlp-tplp-htc;mlp-tplp-htcdl;mlp-lpnmr-ht;mlp-lpnmr-htc;mlp-lpnmr-htcdl" />
		</setting>
		<setting name="goal" tag="goal">
			<variable cmd="--approach={}"
				value="mlp-tplp-ht;mlp-tplp-htc;mlp-tplp-htcdl" />
		</setting>
	</system>


	<distjob name="dist-generic" timeout="1200s" runs="1" template_options="--single"
		script_mode="timeout" walltime="23h 59m 59s" cpt="4" />

	<benchmark name="dentist-goal">
		<files path="../examples/dentist">
			<encoding file="dentist.lp" />
			<encoding file="dentist-goal.lp" />
			<add file="instances/size-1.lp" cmdline="--timepoint-limit=110" />
			<add file="instances/size-5.lp" cmdline="--timepoint-limit=550" />
			<add file="instances/size-7.lp" cmdline="--timepoint-limit=770" />
			<add file="instances/size-10.lp" cmdline="--timepoint-limit=1100" />
		</files>
	</benchmark>


	<project
		name="clasp-seq" job="dist-generic">
		<runtag machine="houat" benchmark="dentist-goal" tag="goal" />
	</project>


</runscript>
