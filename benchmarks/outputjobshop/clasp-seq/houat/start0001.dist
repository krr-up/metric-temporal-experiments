#!/bin/bash
#SBATCH --output=out.%j
#SBATCH --error=err.%j
#SBATCH --time=00-23:59:59        # walltime
#SBATCH --cpus-per-task=4    # number of processor cores (i.e. tasks)
#SBATCH --partition=kr
                  # additional dist options (specified via runscript setting)

# Good Idea to stop operation on first error.
set -e

# Load environment modules for your application here.
source ~/.bashrc
source ~/miniconda3/bin/activate
source activate memelingo

# Run jobs
jobs="results/jobshop-suite-10/memelingo-1-lambda-large_50_mlp-tplp-htcdl/instances/ft10const15/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_50_mlp-tplp-htcdl/instances/ft10const2/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_50_mlp-tplp-htcdl/instances/ft10const5/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_50_mlp-tplp-htcdl/instances/ft10const10/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htc/instances/ft10const15/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htc/instances/ft10const2/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htc/instances/ft10const5/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htc/instances/ft10const10/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htcdl/instances/ft10const15/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htcdl/instances/ft10const2/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htcdl/instances/ft10const5/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_55_mlp-tplp-htcdl/instances/ft10const10/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htc/instances/ft10const15/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htc/instances/ft10const2/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htc/instances/ft10const5/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htc/instances/ft10const10/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htcdl/instances/ft10const15/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htcdl/instances/ft10const2/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htcdl/instances/ft10const5/run1/start.sh
results/jobshop-suite-10/memelingo-1-lambda-large_60_mlp-tplp-htcdl/instances/ft10const10/run1/start.sh
"
echo running jobs@$(hostname)...
echo ""
echo "jobs:" $jobs
echo ""
for i in $jobs
do
    echo "running " $i
    $i
done
