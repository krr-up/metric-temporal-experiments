#!/bin/bash
#SBATCH --output=out.%j
#SBATCH --error=err.%j
#SBATCH --time=00-23:59:59        # walltime
#SBATCH --cpus-per-task=4    # number of processor cores (i.e. tasks)
#SBATCH --partition=kr
                  # additional dist options (specified via runscript setting)

# Good Idea to stop operation on first error.
set -e

# Load environment modules for your application here.
source ~/.bashrc
source ~/miniconda3/bin/activate
source activate memelingo

# Run jobs
jobs="results/mapf-suite-x6_y6/memelingo-1-allapproaches_mlp-tplp-ht/instances/x6_y6_a1_f1/run1/start.sh
results/mapf-suite-x6_y6/memelingo-1-allapproaches_mlp-tplp-htc/instances/x6_y6_a1_f1/run1/start.sh
results/mapf-suite-x6_y6/memelingo-1-allapproaches_mlp-tplp-htcdl/instances/x6_y6_a1_f1/run1/start.sh
"
echo running jobs@$(hostname)...
echo ""
echo "jobs:" $jobs
echo ""
for i in $jobs
do
    echo "running " $i
    $i
done
