
% Initial program
% a :- initially.
% next((2,3),b) :- a.

%
#const lambda=2.
time(0..lambda-1).

% Base translation done with renopro
h(a,T):- h(_initially, T).
h(_next((2,3),b), T):- h(a, T).
h(_eventually((2,3),b), T):- h(a, T).

% Also generated by renopro
formula(_initially).
formula(a).


% Satisfaction for initially
h(_initially, 0).
:- h(_initially, T), time(T), T>0.

% Satisfaction for next
h(X, T+1):- h(_next(I,X), T), time(T), T<lambda-1.
:- h(_next(I,X), T), time(T), T=lambda-1.

% Satisfaction for eventually
h(X, T): time(T'), T'>=T:- h(_eventually(I,X), T), time(T).
h(_eventually((2,3),X), T'):- h(X, T), time(T), time(T'), T'<=T, 1{X=a; X=b}1.

